#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

A project says how its password manager's CLI is invoked, and that is the
whole of what adopting it takes. So the fixture declares four stores, in
the four shapes a CLI comes in, and each one is a script this check writes:
nothing with a product behind it, which is the point -- "bring your own" is
either true for something homegrown or it is aspirational.

The shapes, and what each one has to be handed to work at all:

- **wraps a command**: a file of references, and the command to run with
  the values in its environment.
- **resolves a file of references**: the same file, written back resolved.
- **dumps a scope**: no references at all -- the scope comes from what this
  project called the environment it selected.
- **one lookup at a time**: one item in, one value out. The lowest common
  denominator, and the one that matters most: a store that can do only this
  is still declarable.

What this reading chose: the value is followed all the way to the service
that named it, by running a command as that service and reading what it
got. A check that stopped at "the CLI was invoked" would establish that
Seal knows how to call a script, which is not what was promised.

Deliberately not asserted, because the prompt withholds it: that any
particular product is supported or named anywhere, and that a declaration
is checked against the real CLI's behaviour -- a mis-stated one is not
promised to be caught before it runs.
"""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import Project, seal, check, expect, project  # noqa: E402

ITEM = "the-api-password"

# A CLI that wraps a command, putting the values in its environment.
WRAPS_A_COMMAND = """#!/bin/sh
env_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env-file) env_file="$2"; shift 2 ;;
    --) shift; break ;;
    *) shift ;;
  esac
done
while IFS='=' read -r key ref; do
  [ -n "$key" ] || continue
  export "$key=from-the-wrapping-store"
done < "$env_file"
exec "$@"
"""

# One that reads a file of references and writes it back, resolved.
RESOLVES_A_FILE = """#!/bin/sh
env_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env-file) env_file="$2"; shift 2 ;;
    *) shift ;;
  esac
done
while IFS='=' read -r key ref; do
  [ -n "$key" ] || continue
  printf '%s=from-the-resolving-store\\n' "$key"
done < "$env_file"
"""

# One that dumps a whole scope, keyed by the names inside it.
DUMPS_A_SCOPE = """#!/bin/sh
printf '%s=from-the-scope-of-%s\\n' "{item}" "$2"
printf 'something-else=nobody-asked-for-this\\n'
"""

# And one that answers a single lookup, which is all some products do.
ONE_LOOKUP_AT_A_TIME = """#!/bin/sh
printf 'from-the-lookup-store\\n'
"""

STORES = (
    ("wraps a command", "wrapping", WRAPS_A_COMMAND, "run",
     ["{cli}", "--env-file", "{env_file}", "--", "{command}"], None,
     "from-the-wrapping-store"),
    ("resolves a file of references", "resolving", RESOLVES_A_FILE, "resolve",
     ["{cli}", "--env-file", "{env_file}"], None,
     "from-the-resolving-store"),
    ("dumps a scope", "scope", DUMPS_A_SCOPE.replace("{item}", ITEM), "fetch",
     ["{cli}", "--scope", "{scope}"], {"dev": {"scope": "the-projects-scope"}},
     "from-the-scope-of-the-projects-scope"),
    ("answers one lookup at a time", "lookup", ONE_LOOKUP_AT_A_TIME, "get",
     ["{cli}", "{item}"], None,
     "from-the-lookup-store"),
)


def a_project_declaring(fixture: Project, shape: str, script: str, form: str,
                        command: list[str], environments: dict | None) -> dict[str, str]:
    """A project whose one service names a value in a store it brought."""
    fixture.tiltfile().service("api", env=f"API_PASSWORD={shape}://{ITEM}\n")
    fixture.deployment("api")
    fixture.codeowners("* @owner\n")
    cli = fixture.write(f"bin/{shape}-cli", script, executable=True)

    declaration = {
        "scheme": f"{shape}://",
        "name": f"a store that {shape}",
        "cli": str(cli),
        "form": form,
        "command": [word.replace("{cli}", str(cli)) for word in command],
    }
    if environments:
        declaration["environments"] = environments
    fixture.write(
        "seal-credentials-config.json",
        json.dumps(
            {"default_env": "dev", "provider": [declaration]}
            if environments
            else {"provider": [declaration]},
            indent=2,
        )
        + "\n",
    )
    return {"PATH": f"{fixture.root / 'bin'}{os.pathsep}{os.environ['PATH']}"}


def body() -> None:
    for shape, slug, script, form, command, environments, expected in STORES:
        with project(f"store-{slug}") as fixture:
            env = a_project_declaring(fixture, slug, script, form, command, environments)

            declared = seal("check", cwd=fixture.root, env=env)
            expect(
                declared.status == 0,
                f"a store that {shape} is a declaration, not a change to the library:\n{declared}",
            )

            # All the way to the service that named the value: the promise is
            # that it arrives, not that a CLI was called.
            reached = seal(
                "run", "--", "sh", "-c", 'printf "%s" "$API_PASSWORD"',
                cwd=fixture.root / "services" / "api",
                env=env,
            )
            expect(
                reached.stdout == expected,
                f"a value from a store that {shape} reaches the service that named it "
                f"(wanted {expected!r}):\n{reached}",
            )

    # A value naming a scheme nothing declares is refused, rather than
    # reaching a service as the literal text of its own reference.
    with project("store-undeclared") as fixture:
        a_project_declaring(fixture, "lookup", ONE_LOOKUP_AT_A_TIME, "get", ["{cli}", "{item}"], None)
        fixture.write("services/api/.env", f"API_PASSWORD=nosuchstore://{ITEM}\n")
        refused = seal(
            "run", "--", "sh", "-c", "true", cwd=fixture.root / "services" / "api"
        )
        expect(
            refused.status != 0 and "nosuchstore://" in refused.output,
            f"a scheme no provider declares is refused, and named:\n{refused}",
        )


check(body)
