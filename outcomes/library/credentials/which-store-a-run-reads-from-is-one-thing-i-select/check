#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

The two "worth covering" points split cleanly on whether a cluster is
needed, so this check establishes them in that order:

- **One declaration resolves differently depending only on what the run
  selected.** `seal run` resolves the same `.env`, against the same
  `seal-credentials-config.json`, twice -- once naming one
  credentials environment, once naming the other, through the two ways a
  run can name one (`--credentials_env` and `SEAL_CREDENTIALS_ENV`,
  see providers.py). Nothing else about the project changes between the two
  runs. This needs no cluster: `seal run` resolves a service's `.env`
  directly, with no overlay or deploy involved at all.
- **Selecting a different shape does not change which store is read.** The
  same credentials environment is selected across two differently-shaped
  Kubernetes overlays -- not two names for the same thing, but two
  Deployments and two stubs, the way a session's shape and a real
  environment's actually differ. Both are deployed in turn and the value
  each container ends up with is read back with `kubectl exec`: the store
  stays the one the run selected, whichever shape got deployed. This half
  needs a real cluster, one overlay at a time.

What this reading chose: the credentials environments are named `blue` and
`green`, deliberately unlike either Kubernetes overlay's name (`dev` and
`prod-like`) -- so a check that passed because the two vocabularies
happened to line up would be caught rather than mistaken for this promise.

Deliberately not asserted, because the prompt withholds it: which store any
environment should use or what the selections should be called -- both are
invented for the fixture and asserted on by nothing but their own presence
-- and that a mis-selected store fails helpfully.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import seal, check, deployed, expect, kubectl, project  # noqa: E402
from helpers.projects import container  # noqa: E402

ITEM = "the-only-item"
KEY = "SETTING"

# A provider whose reference embeds the vault a selected environment maps
# to, so the value it hands back names exactly which vault was read --
# proof of which store answered, not just that one did.
LOOKUP_CLI = """#!/bin/sh
printf 'resolved-via-%s\\n' "$1"
"""


def declare(cli: Path) -> dict:
    return {
        "provider": [
            {
                "scheme": "store://",
                "name": "a store scoped per credentials environment",
                "cli": str(cli),
                "form": "get",
                "reference": "{vault}::{item}",
                "command": [str(cli), "{item}"],
                "environments": {
                    "blue": {"vault": "blue-vault"},
                    "green": {"vault": "green-vault"},
                },
            }
        ]
    }


def expected(vault: str) -> str:
    return f"resolved-via-{vault}::{ITEM}"


def body() -> None:
    # One declaration, two selections, nothing else different -- no cluster.
    with project("selection-picks-the-store") as fixture:
        cli = fixture.write("bin/lookup-cli", LOOKUP_CLI, executable=True)
        fixture.write("seal-credentials-config.json", json.dumps(declare(cli), indent=2) + "\n")
        fixture.tiltfile().service("api", env=f"{KEY}=store://{ITEM}\n")
        service_dir = fixture.root / "services" / "api"

        via_flag = seal(
            "run", "--credentials_env", "blue", "--", "sh", "-c", f'printf "%s" "${KEY}"',
            cwd=service_dir,
        )
        expect(
            via_flag.stdout == expected("blue-vault"),
            f"selecting 'blue' with --credentials_env reads the blue vault "
            f"(wanted {expected('blue-vault')!r}):\n{via_flag}",
        )

        via_env_var = seal(
            "run", "--", "sh", "-c", f'printf "%s" "${KEY}"',
            cwd=service_dir, env={"SEAL_CREDENTIALS_ENV": "green"},
        )
        expect(
            via_env_var.stdout == expected("green-vault"),
            f"selecting 'green' with SEAL_CREDENTIALS_ENV reads the green vault, "
            f"from the same declaration and the same .env (wanted "
            f"{expected('green-vault')!r}):\n{via_env_var}",
        )

    # The same selection, two different deploy shapes -- needs a cluster.
    with project("shape-does-not-pick-the-store") as fixture:
        cli = fixture.write("bin/lookup-cli", LOOKUP_CLI, executable=True)
        fixture.write("seal-credentials-config.json", json.dumps(declare(cli), indent=2) + "\n")
        fixture.codeowners()
        fixture.service("api", env=f"{KEY}=store://{ITEM}\n")

        def api_containers() -> list[dict]:
            return [
                container("api", image="api", probe=False)
                | {
                    "readinessProbe": {
                        "httpGet": {"path": "/", "port": 8080},
                        "periodSeconds": 2,
                        "failureThreshold": 30,
                    },
                    "envFrom": [{"secretRef": {"name": "api-values"}}],
                }
            ]

        stub = {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {"name": "api-values", "annotations": {"seal-test.dev/fill-from": "api"}},
            "type": "Opaque",
        }
        serves_dockerfile = (
            "FROM busybox:1.36\n"
            "RUN mkdir -p /www && printf 'serving\\n' > /www/index.html\n"
            'CMD ["httpd", "-f", "-p", "8080", "-h", "/www"]\n'
        )
        # deploys() sets up the service directory, its Dockerfile, its own
        # Tiltfile and the 'dev' overlay's Deployment in one call; each
        # overlay's stub is added beside its own Deployment.
        fixture.manifest("dev", "api-values", stub)
        fixture.deploys("api", serves_dockerfile, containers=api_containers(), overlay="dev")
        fixture.manifest("prod-like", "api-values", stub)
        fixture.deployment("api", containers=api_containers(), overlay="prod-like")

        for overlay in ("dev", "prod-like"):
            with deployed(
                fixture, "--credentials_env", "green", "--",
                "--k8s_overlay", overlay, overlay=overlay,
            ) as run:
                expect(
                    run.status == 0,
                    f"a project deploying the '{overlay}' shape with 'green' selected "
                    f"comes up:\n{run}",
                )
                arrived = kubectl("exec", "deploy/api", "--", "sh", "-c", f'printf "%s" "${KEY}"')
                expect(
                    arrived.stdout == expected("green-vault"),
                    f"the '{overlay}' shape reads the same store the run selected, the "
                    f"green vault, regardless of which shape got deployed (wanted "
                    f"{expected('green-vault')!r}):\n{arrived}",
                )


check(body)
