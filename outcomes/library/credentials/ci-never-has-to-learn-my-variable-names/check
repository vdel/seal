#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

What CI is spared learning is not the pipeline's own knowledge but the
declaration a project commits: `seal-credentials-config.json` names a
scheme, a CLI and a form -- never a key a `.env` happens to declare. That is
what makes CI's own file boilerplate, since nothing about a service's own
keys ever has to appear in either. So this check reads the declaration back
as text and looks for the application's variable names in it, the same
question a human copying the CI file to a second project would ask.

- **A project's declaration contains no application variable name, and its
  services still get their values.** Checked by resolving a value through
  `seal run` -- the same path a container's own entrypoint takes --
  while grepping the config file's own text for the key that named it.
- **A service that starts needing another key needs no CI change.** The
  declaration is snapshotted, a second key is added to the service's `.env`
  alone, and the file is read back byte for byte: no edit, and the new key
  resolves exactly as the first one did.

What this reading chose: `seal-credentials-config.json` stands in for
"CI" here, since it is the one file between a pipeline and a store a key
name could leak into (see /rfcs/0006-credential-resolution.md) -- the
pipeline's own YAML is deliberately not asserted on, see below. A single
lookup-form provider, the shape every surveyed product supports, is enough:
the promise is about what the declaration has to name, not which form it
takes -- that is checked by a promise of its own.

Deliberately not asserted, because the prompt withholds it: which CI system
a project uses, or that CI needs no secret at all -- one credential CI holds
to authenticate the store is not an application variable name.
"""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import seal, check, expect, project  # noqa: E402

FIRST_KEY, FIRST_ITEM, FIRST_VALUE = "FIRST_APP_SETTING", "item-one", "resolved-value-one"
SECOND_KEY, SECOND_ITEM, SECOND_VALUE = "SECOND_APP_SETTING", "item-two", "resolved-value-two"

# A store that answers one lookup at a time -- the lowest common denominator,
# and the shape a declaration takes here is not what this promise is about.
LOOKUP_CLI = f"""#!/bin/sh
case "$1" in
  {FIRST_ITEM}) printf '%s\\n' '{FIRST_VALUE}' ;;
  {SECOND_ITEM}) printf '%s\\n' '{SECOND_VALUE}' ;;
  *) exit 1 ;;
esac
"""

CONFIG_PATH = "seal-credentials-config.json"


def body() -> None:
    with project("ci-agnostic-of-keys") as fixture:
        cli = fixture.write("bin/lookup-cli", LOOKUP_CLI, executable=True)
        declaration = {
            "provider": [
                {
                    "scheme": "store://",
                    "name": "a lookup store",
                    "cli": str(cli),
                    "form": "get",
                    "command": [str(cli), "{item}"],
                }
            ]
        }
        fixture.write(CONFIG_PATH, json.dumps(declaration, indent=2) + "\n")
        fixture.tiltfile().service("api", env=f"{FIRST_KEY}=store://{FIRST_ITEM}\n")

        env = {"PATH": f"{fixture.root / 'bin'}{os.pathsep}{os.environ['PATH']}"}

        config_text = fixture.read(CONFIG_PATH)
        expect(
            FIRST_KEY not in config_text,
            f"the declaration names no application variable, but held {FIRST_KEY!r}:\n{config_text}",
        )

        first = seal(
            "run", "--", "sh", "-c", f'printf "%s" "${FIRST_KEY}"',
            cwd=fixture.root / "services" / "api", env=env,
        )
        expect(
            first.stdout == FIRST_VALUE,
            f"the service gets its value from a declaration that never named it "
            f"(wanted {FIRST_VALUE!r}):\n{first}",
        )

        # A service starting to need another key: the declaration is watched
        # while it happens, because what makes this a promise rather than a
        # convenience is that there is nothing here to edit.
        before = fixture.read(CONFIG_PATH)
        fixture.write(
            "services/api/.env",
            f"{FIRST_KEY}=store://{FIRST_ITEM}\n{SECOND_KEY}=store://{SECOND_ITEM}\n",
        )
        after = fixture.read(CONFIG_PATH)
        expect(
            after == before,
            "a service needing another key needs no change to the declaration, but it "
            "changed",
        )
        expect(
            SECOND_KEY not in after,
            f"the declaration still names no application variable, but now holds "
            f"{SECOND_KEY!r}:\n{after}",
        )

        second = seal(
            "run", "--", "sh", "-c", f'printf "%s|%s" "${FIRST_KEY}" "${SECOND_KEY}"',
            cwd=fixture.root / "services" / "api", env=env,
        )
        expect(
            second.stdout == f"{FIRST_VALUE}|{SECOND_VALUE}",
            f"both keys resolve through the declaration nothing was added to "
            f"(wanted {FIRST_VALUE}|{SECOND_VALUE}):\n{second}",
        )


check(body)
