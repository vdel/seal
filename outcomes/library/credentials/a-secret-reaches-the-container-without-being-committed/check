#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

The promise has two halves, and this check keeps them separate because only
one needs a running container to establish:

- **The reference is committed and readable -- the schema.** Read straight
  off the project's own `.env`, no cluster required.
- **The value itself appears nowhere in the project.** Every file the
  project is made of is scanned for the literal secret text before anything
  is deployed -- committed, forked or kept in history is exactly what a
  project's own working tree stands in for here.
- **The value still reaches the running container.** The one half that
  actually needs a cluster: the fixture is deployed and the value is read
  back out of the container with `kubectl exec`, the same way
  `a-credential-is-written-down-once` follows a value to its service.

What this reading chose: a store CLI this check writes (see
`whatever-shape-my-password-managers-cli-takes-i-declare-it`), returning a
value distinctive enough that finding it anywhere in the project's own files
is unambiguous -- a short literal like `"secret"` could appear by coincidence
and a check that found it would be finding nothing. The CLI script itself is
checked into the fixture, the way a project might commit its own resolver --
but the value it hands back lives in a file outside the fixture entirely,
the way a real store's own storage is never part of a project's working
tree. Committing the CLI is fine; committing what it returns is the thing
this promise is about.

Deliberately not asserted, because the prompt withholds it: that the store
itself is secure or access-controlled, and that a project cannot commit a
secret some other way -- this promises a path that does not require it, not
that no other path exists.
"""

import json
import os
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import check, deployed, expect, kubectl, project  # noqa: E402
from helpers.projects import container  # noqa: E402

SERVES = """FROM busybox:1.36
RUN mkdir -p /www && printf 'serving\\n' > /www/index.html
CMD ["httpd", "-f", "-p", "8080", "-h", "/www"]
"""
PROBE = {"httpGet": {"path": "/", "port": 8080}, "periodSeconds": 2, "failureThreshold": 30}

# What the overlay says carries this service's values -- Seal fills
# what an overlay marks, which is the mechanism the running-container half of
# this check rides on.
VALUES = {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
        "name": "vault-values",
        "annotations": {"seal-test.dev/fill-from": "vault"},
    },
    "type": "Opaque",
}

ITEM = "the-database-password"
KEY = "DB_PASSWORD"
REFERENCE = f"lookup://{ITEM}"
# Distinctive enough that finding it anywhere in the project's own files
# could not be a coincidence.
SECRET_VALUE = "not-committed-a1c9f26e-secret-value"

LOOKUP_CLI_TEMPLATE = """#!/bin/sh
cat '{store_file}'
"""


def files_naming(root: Path, needle: str) -> list[str]:
    """Every file this project is made of whose text contains `needle`, as
    paths relative to `root`. What a run leaves behind is not part of the
    project, so results stay out of the search."""
    found = []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        if "tests-results" in path.parts or ".git" in path.parts:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if needle in text:
            found.append(str(path.relative_to(root)))
    return found


def body() -> None:
    # The store's own storage: outside the fixture entirely, the way a real
    # password manager's data is never part of a project's working tree. The
    # CLI script committed into the fixture only knows where to find it.
    store_fd, store_path = tempfile.mkstemp(prefix="seal-store-")
    with os.fdopen(store_fd, "w") as handle:
        handle.write(SECRET_VALUE + "\n")

    try:
        _body(store_path)
    finally:
        os.unlink(store_path)


def _body(store_path: str) -> None:
    with project("secret-reaches-container") as fixture:
        fixture.codeowners()
        cli = fixture.write(
            "bin/lookup-cli", LOOKUP_CLI_TEMPLATE.format(store_file=store_path), executable=True
        )
        fixture.write(
            "seal-credentials-config.json",
            json.dumps(
                {
                    "provider": [
                        {
                            "scheme": "lookup://",
                            "name": "a lookup store",
                            "cli": str(cli),
                            "form": "get",
                            "command": [str(cli), "{item}"],
                        }
                    ]
                },
                indent=2,
            )
            + "\n",
        )
        fixture.service("vault", env=f"{KEY}={REFERENCE}\n")
        fixture.manifest("dev", "vault-values", VALUES)
        fixture.deploys(
            "vault",
            SERVES,
            containers=[
                container("vault", image="vault", probe=False)
                | {"readinessProbe": PROBE, "envFrom": [{"secretRef": {"name": "vault-values"}}]}
            ],
        )

        # The reference is committed and readable -- that is the schema, and
        # it needs no cluster to establish.
        env_text = fixture.read("services/vault/.env")
        expect(
            REFERENCE in env_text,
            f"the reference is committed and readable in the .env (the schema), but "
            f"was not found:\n{env_text}",
        )

        # The value itself is not: a checkout, a fork and history all stand
        # in for the project's own working tree here.
        leaked = files_naming(fixture.root, SECRET_VALUE)
        expect(
            not leaked,
            f"the secret's value appears nowhere in the project, but was found in: {leaked}",
        )

        # The one half that needs a cluster: does the value reach the
        # container that is actually running.
        with deployed(fixture) as run:
            expect(run.status == 0, f"a project declaring a value in a store comes up:\n{run}")
            arrived = kubectl("exec", "deploy/vault", "--", "sh", "-c", f'printf "%s" "${KEY}"')
            expect(
                arrived.stdout == SECRET_VALUE,
                f"the value the store holds reaches the running container (wanted "
                f"{SECRET_VALUE!r}):\n{arrived}",
            )


check(body)
