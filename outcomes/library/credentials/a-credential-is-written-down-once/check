#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

The service that needs a value declares it, in one file, and that file's key
names are the schema. The promise is not that a value can be delivered --
every system can do that -- but that there is exactly one place it is
written down, so nothing can disagree with it.

Which is why this check follows the value into the running container and
watches the project while it does:

- **Adding a key means editing one file.** Asserted by comparing the whole
  project before and after the edit: one file differs, and the value is in
  the container afterwards. A promise about there being no second list is
  established by there being no second edit.
- **A key the service stops declaring stops reaching it.** The same
  mechanism read the other way round -- if the `.env` were a starting point
  rather than the schema, a removed key would linger.

What this reading chose: a literal value. Where a value comes from -- a
literal, a store, or the manifests -- is a shape a declaration can take, and
the promise is about there being one declaration whichever it is. The store
shapes are a promise of their own, checked beside this one.

Deliberately not asserted, because the prompt withholds it: anything about
the value itself, and whether it was committed -- a different promise.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import check, deployed, expect, kubectl, project  # noqa: E402
from helpers.projects import container  # noqa: E402

SERVES = """FROM busybox:1.36
RUN mkdir -p /www && printf 'serving\\n' > /www/index.html
CMD ["httpd", "-f", "-p", "8080", "-h", "/www"]
"""

PROBE = {"httpGet": {"path": "/", "port": 8080}, "periodSeconds": 2, "failureThreshold": 30}

# What the overlay says carries this service's values. Seal fills what
# an overlay marks and supplies nothing it did not ask for.
VALUES = {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
        "name": "keeper-values",
        "annotations": {"seal-test.dev/fill-from": "keeper"},
    },
    "type": "Opaque",
}

FIRST_KEY, FIRST_VALUE = "GREETING", "hello-from-the-declaration"
ADDED_KEY, ADDED_VALUE = "FAREWELL", "and-goodbye-from-it-too"


def snapshot(root: Path) -> dict[str, str]:
    """Every file this project is made of, as text. What a run leaves behind
    is not part of the project, so results stay out of it."""
    return {
        str(path.relative_to(root)): path.read_bytes().hex()
        for path in sorted(root.rglob("*"))
        if path.is_file() and "tests-results" not in path.parts and ".git" not in path.parts
    }


def value_in_the_container(key: str):
    return kubectl("exec", "deploy/keeper", "--", "sh", "-c", f'printf "%s" "${key}"')


def body() -> None:
    with project("one-declaration") as fixture:
        fixture.codeowners("* @owner\n")
        fixture.service("keeper", env=f"{FIRST_KEY}={FIRST_VALUE}\n")
        fixture.manifest("dev", "keeper-values", VALUES)
        fixture.deploys(
            "keeper",
            SERVES,
            containers=[
                container("keeper", image="keeper", probe=False)
                | {
                    "readinessProbe": PROBE,
                    "envFrom": [{"secretRef": {"name": "keeper-values"}}],
                }
            ],
        )

        with deployed(fixture) as run:
            expect(run.status == 0, f"a project declaring a value comes up:\n{run}")
            arrived = value_in_the_container(FIRST_KEY)
            expect(
                arrived.stdout == FIRST_VALUE,
                f"the value the service declared reaches it (wanted {FIRST_VALUE!r}):\n{arrived}",
            )

        # Adding a key. The project is watched while it happens: what makes
        # this a promise rather than a convenience is that there is no
        # second place to edit.
        before = snapshot(fixture.root)
        fixture.write(
            "services/keeper/.env", f"{FIRST_KEY}={FIRST_VALUE}\n{ADDED_KEY}={ADDED_VALUE}\n"
        )
        edited = [
            path for path, body in snapshot(fixture.root).items() if before.get(path) != body
        ]
        expect(
            edited == ["services/keeper/.env"],
            f"adding a key means editing one file, and this edited: {edited}",
        )

        with deployed(fixture) as run:
            expect(run.status == 0, f"the run after a key was added succeeds:\n{run}")
            added = value_in_the_container(ADDED_KEY)
            expect(
                added.stdout == ADDED_VALUE,
                f"a key added to the one file reaches the service (wanted "
                f"{ADDED_VALUE!r}):\n{added}",
            )
            kept = value_in_the_container(FIRST_KEY)
            expect(
                kept.stdout == FIRST_VALUE,
                f"and the key that was already there still does:\n{kept}",
            )

        # And taking it away again: the `.env` is the schema, so a key it no
        # longer declares is one the service no longer gets.
        fixture.write("services/keeper/.env", f"{FIRST_KEY}={FIRST_VALUE}\n")
        with deployed(fixture) as run:
            expect(run.status == 0, f"the run after a key was removed succeeds:\n{run}")
            gone = value_in_the_container(ADDED_KEY)
            expect(
                gone.stdout == "",
                f"a key the service no longer declares stops reaching it:\n{gone}",
            )


check(body)
