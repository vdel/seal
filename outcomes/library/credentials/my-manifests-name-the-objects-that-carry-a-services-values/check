#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

Two of the three "worth covering" points turn on what actually lands in a
running pod, which needs a cluster; the third -- that marking nothing is not
broken by it -- turns on nothing but the static check, so it is established
first and needs no cluster at all:

- **A project that marks nothing is not broken by that.** A project with a
  Deployment and no `seal-test.dev/fill-from` annotation anywhere passes
  `seal check` cleanly -- opting out of marking is not a shape the
  check treats as wrong.
- **An object the project declares and marks is filled; one it does not
  mark is left alone.** The fixture below wires one Secret and one ConfigMap
  onto the same container: the Secret marked `fill-from` and claiming one
  key of the service's `.env`, the ConfigMap left unmarked with a value the
  project wrote directly into its manifest. After a real deploy, both are
  read back with `kubectl exec` -- the marked one holding what the service
  declared, the unmarked one holding exactly what the project wrote, because
  nothing here ever touched it.
- **Names and grouping are the project's.** The Secret and ConfigMap above
  are named and split the way an invented fixture project chooses to, not
  the way Seal would have -- one object per credential group rather
  than one object per service -- and both values land under those names.

What this reading chose: the "session assembles a pod's environment the
same way the shape that ships does" is read as "the mechanism is the
overlay's own kustomize objects, not a special case for a session" -- proven
by there being no session-specific object kind or name anywhere in this
fixture, rather than by running two overlays side by side, which the
`which-store-a-run-reads-from-is-one-thing-i-select` check already covers
from the credentials-environment angle.

Deliberately not asserted, because the prompt withholds it: which objects a
project *should* use or how many, and whether the manifests are otherwise
valid -- this is about who names the objects, not about them being right.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import seal, check, deployed, expect, kubectl, project  # noqa: E402
from helpers.projects import container  # noqa: E402

SERVES = """FROM busybox:1.36
RUN mkdir -p /www && printf 'serving\\n' > /www/index.html
CMD ["httpd", "-f", "-p", "8080", "-h", "/www"]
"""
PROBE = {"httpGet": {"path": "/", "port": 8080}, "periodSeconds": 2, "failureThreshold": 30}

TOKEN_KEY, TOKEN_VALUE = "API_TOKEN", "the-services-declared-token"
# A value the project wrote directly into its own manifest -- never claimed
# by any stub, never touched by Seal.
UNMARKED_KEY, UNMARKED_VALUE = "FEATURE_FLAG", "on-because-the-project-said-so"

# The project's own names and grouping: one Secret for the credential the
# service declared, and a ConfigMap the project populated itself. Neither
# name, and no part of this split, is anything Seal would have chosen.
MARKED_SECRET = {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
        "name": "sprocket-api-credential",
        "annotations": {"seal-test.dev/fill-from": "sprocket"},
    },
    "type": "Opaque",
}
UNMARKED_CONFIGMAP = {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {"name": "sprocket-static-flags"},
    "data": {UNMARKED_KEY: UNMARKED_VALUE},
}


def sprocket_containers() -> list[dict]:
    return [
        container("sprocket", image="sprocket", probe=False)
        | {
            "readinessProbe": PROBE,
            "envFrom": [
                {"secretRef": {"name": "sprocket-api-credential"}},
                {"configMapRef": {"name": "sprocket-static-flags"}},
            ],
        }
    ]


def body() -> None:
    # A project that marks nothing: everything else still works, checked
    # without a cluster.
    with project("marks-nothing") as fixture:
        fixture.service("plain", env="GREETING=hello\n")
        fixture.deploys(
            "plain",
            SERVES,
            containers=[
                container(
                    "plain", image="plain",
                    env=[{"name": "GREETING", "value": "hello"}],
                )
            ],
        )
        checked = seal("check", cwd=fixture.root)
        expect(
            checked.status == 0,
            f"a project that marks no object passes seal check -- opting out of "
            f"marking is not broken by it:\n{checked}",
        )

    # An object marked is filled with the project's own names; one left
    # unmarked is left exactly as the project wrote it. Needs a cluster.
    with project("names-its-own-objects") as fixture:
        fixture.codeowners()
        fixture.service("sprocket", env=f"{TOKEN_KEY}={TOKEN_VALUE}\n")
        fixture.manifest("dev", "sprocket-api-credential", MARKED_SECRET)
        fixture.manifest("dev", "sprocket-static-flags", UNMARKED_CONFIGMAP)
        fixture.deploys("sprocket", SERVES, containers=sprocket_containers())

        with deployed(fixture) as run:
            expect(run.status == 0, f"a project naming its own objects comes up:\n{run}")
            token = kubectl("exec", "deploy/sprocket", "--", "sh", "-c", f'printf "%s" "${TOKEN_KEY}"')
            expect(
                token.stdout == TOKEN_VALUE,
                f"the marked Secret is filled with what the service declared, under the "
                f"project's own name (wanted {TOKEN_VALUE!r}):\n{token}",
            )
            flag = kubectl("exec", "deploy/sprocket", "--", "sh", "-c", f'printf "%s" "${UNMARKED_KEY}"')
            expect(
                flag.stdout == UNMARKED_VALUE,
                f"the unmarked ConfigMap reaches the container exactly as the project "
                f"wrote it, untouched by Seal (wanted {UNMARKED_VALUE!r}):\n{flag}",
            )


check(body)
