#!/usr/bin/env python3
"""Translated from prompt.md, beside this file.

"Needs no password manager to run" is read literally: a project whose values
are all literals or `k8s://` markers gets no `seal-credentials-config.json`
at all, and nothing in the CLI's path to a resolved value stops to ask for
one. So this check builds such a project, confirms the file it never wrote
is not required, and reads a value back through `seal run` -- the same
resolution path a container's entrypoint takes -- with nothing declared and
no store CLI anywhere near it.

- **A project with no store reference runs without one installed, logged in,
  or declared.** Its `.env` holds a literal and a `k8s://` marker, no
  config file exists, and both `seal run` and `seal check`
  succeed regardless.
- **A project that does reference one still resolves it.** A second,
  unrelated fixture, built the same way the store-shape promise's own
  checks build theirs, resolves normally -- so "needs none" is read as "is
  not made to declare one," not as "cannot use one."

What this reading chose: a `k8s://`-marked value is exercised alongside the
literal, since it is the other way a project supplies a value without a
store (see /rfcs/0006-credential-resolution.md) -- resolving neither is what
"no secret in a store" means for a `.env` as a whole, not only for its
literals.

Deliberately not asserted, because the prompt withholds it: a project that
mixes an undeclared reference in among its literals -- a different promise,
checked where a scheme no provider declares is refused.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from helpers import seal, check, expect, project  # noqa: E402
from helpers.projects import container  # noqa: E402

GREETING_KEY, GREETING_VALUE = "GREETING", "hello-with-no-store-at-all"
MARKED_KEY = "BAKED_IN"

STORE_KEY, ITEM, STORE_VALUE = "API_TOKEN", "the-only-item", "resolved-from-the-one-store"

CONFIG_PATH = "seal-credentials-config.json"

ONE_LOOKUP_CLI = f"""#!/bin/sh
printf '%s\\n' '{STORE_VALUE}'
"""

WEB_DOCKERFILE = "FROM busybox:1.36\nCMD [\"sleep\", \"3600\"]\n"


def body() -> None:
    with project("no-store-no-manager") as fixture:
        fixture.service(
            "web", env=f"{GREETING_KEY}={GREETING_VALUE}\n{MARKED_KEY}=k8s://from-the-manifest\n"
        )
        # Manifests, so `seal check` has a shape to check at all -- this
        # promise is about a project with no *store* reference, not one with
        # no services. Both keys are accounted for directly by the manifest,
        # the literal and the k8s:// marker alike, so nothing here reaches for
        # a store to pass.
        fixture.deploys(
            "web",
            WEB_DOCKERFILE,
            containers=[
                container(
                    "web",
                    image="web",
                    env=[
                        {"name": GREETING_KEY, "value": GREETING_VALUE},
                        {"name": MARKED_KEY, "value": "baked-directly-into-the-manifest"},
                    ],
                )
            ],
        )
        expect(
            not (fixture.root / CONFIG_PATH).exists(),
            f"a project with no store reference declares no {CONFIG_PATH}",
        )

        resolved = seal(
            "run", "--", "sh", "-c", f'printf "%s|%s" "${GREETING_KEY}" "${MARKED_KEY}"',
            cwd=fixture.root / "services" / "web",
        )
        expect(
            resolved.status == 0,
            f"a project whose values are all literals or k8s:// markers runs with no "
            f"password manager installed, logged in or declared:\n{resolved}",
        )
        expect(
            resolved.stdout == f"{GREETING_VALUE}|",
            "the literal passes straight through, and the k8s://-marked key is never "
            f"resolved or injected (wanted {GREETING_VALUE!r} then empty):\n{resolved}",
        )

        checked = seal("check", cwd=fixture.root)
        expect(
            checked.status == 0,
            f"such a project passes `seal check` with nothing installed, logged "
            f"in or declared:\n{checked}",
        )

    with project("does-reference-one") as fixture:
        cli = fixture.write("bin/lookup-cli", ONE_LOOKUP_CLI, executable=True)
        fixture.write(
            CONFIG_PATH,
            json.dumps(
                {
                    "provider": [
                        {
                            "scheme": "store://",
                            "name": "a lookup store",
                            "cli": str(cli),
                            "form": "get",
                            "command": [str(cli), "{item}"],
                        }
                    ]
                },
                indent=2,
            )
            + "\n",
        )
        fixture.tiltfile().service("api", env=f"{STORE_KEY}=store://{ITEM}\n")

        reached = seal(
            "run", "--", "sh", "-c", f'printf "%s" "${STORE_KEY}"',
            cwd=fixture.root / "services" / "api",
        )
        expect(
            reached.stdout == STORE_VALUE,
            f"a project that does reference a store still resolves it "
            f"(wanted {STORE_VALUE!r}):\n{reached}",
        )


check(body)
