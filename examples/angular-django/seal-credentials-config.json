{
  "default_env": "dev",
  "provider": [
    {
      "scheme": "pass://",
      "name": "Proton Pass",
      "cli": "pass-cli",
      "install_hint": "https://proton.me/pass/download",
      "form": "run",
      "reference": "pass://{vault}/{item}",
      "command": ["pass-cli", "run", "--env-file", "{env_file}", "--", "{command}"],
      "environments": {
        "dev": { "vault": "project-seal-dev" },
        "prod": { "vault": "project-seal-prod" }
      }
    }
  ]
}
