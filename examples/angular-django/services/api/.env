# Credentials for the 'api' service, resolved by `seal run`/`seal up`/`seal
# ci` in every scope -- see /docs/credentials.md at the repo root for the
# full picture: the `.env` format, what each value kind means, and how a
# `pass://` reference works when a project needs one.

# Safest value ('0'), since there's no separate dev-only override for this
# one -- flip it locally yourself (uncommitted) for Django's debug pages.
DEBUG=0

# A literal, not a `pass://` reference, for two reasons. Nothing built from
# this directory is ever deployed anywhere (see CLAUDE.md's scope
# boundary), so there is no secret here to keep. And a reference would make
# this example's CI only as reliable as a password manager being reachable
# from a runner -- a dependency it has no reason to carry.
#
# A real project replaces this with the reference it would actually use:
#
#   DJANGO_SECRET_KEY=pass://django-secret-key/password
#
# That one line is the whole of what turns a password manager on: seal
# reaches for one only when a value names it, so a `.env` of literals and
# `k8s://` markers invokes no provider at all.
#
# The reference names an item and nothing else. Which *store* holds it is
# the project's own declaration -- see seal-credentials-config.json at
# this project's root, where `pass://` is mapped to a CLI and to a vault per
# environment, and `--credentials_env` picks which. That split is why this
# same line is valid in every environment.
DJANGO_SECRET_KEY=dev-only-value-nothing-here-is-ever-deployed

# Assembled from the bundled dev Postgres/Valkey's own k8s Services in dev;
# from a Secret provisioned out of band for DATABASE_URL in an environment
# whose own overlay repoints it there.
DATABASE_URL=k8s://
CELERY_BROKER_URL=k8s://
CELERY_RESULT_BACKEND=k8s://
